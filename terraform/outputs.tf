output "project_id" {
  value       = google_project.project.project_id
  description = "The unique GCP Project ID."
}

output "project_number" {
  value       = google_project.project.number
  description = "The GCP Project Number."
}

output "project_name" {
  value       = google_project.project.name
  description = "The name of the GCP Project."
}

output "pet_name" {
  value       = try(random_pet.project[0].id, null)
  description = "The dynamic pet name generated by random_pet. Null when var.project_id is set."
}

output "enabled_services" {
  value       = keys(google_project_service.services)
  description = "List of enabled GCP services."
}
